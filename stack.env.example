# In Portainer, paste these as the stack's Environment variables — Portainer
# writes them to a `stack.env` file that docker-compose.yml loads. For plain CLI,
# copy this to `stack.env` (gitignored) and fill in real values.
#
# Grafana admin login (change these before first deploy).
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# --- E-mail alerts via Gmail SMTP ---
# Gmail with 2FA requires an "App Password" (NOT your normal password):
#   Google Account -> Security -> 2-Step Verification -> App passwords.
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=arthur.werle@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_ADDRESS=arthur.werle@gmail.com
SMTP_FROM_NAME=Homelab Grafana

# --- Retention ---
# Metrics retention on disk (mini PC friendly). Logs retention is set in
# loki/loki-config.yml (default 30 days).
PROM_RETENTION=15d
